// =============================================================================
//  bacterial-wgs-nf — nextflow.config
// =============================================================================

params {
    // ── Input / output ────────────────────────────────────────────────────────
    reads                 = null    // "reads/*_R{1,2}*.fastq.gz"
    assemblies            = null    // alternative entry: "assemblies/*.fasta"
    outdir                = "results"

    // ── References and databases ─────────────────────────────────────────────
    phix                  = null    // PhiX FASTA; null = skip PhiX removal
    kraken_db             = null    // Kraken2 database (also used by Bracken)
    reference             = null    // reference genome FASTA (FastANI, Snippy, QUAST)
    card_json             = null    // CARD card.json; null = skip RGI

    // ── Read processing ──────────────────────────────────────────────────────
    trimmer               = "trim_galore"   // 'trim_galore' (default) or 'fastp'
    trim_quality          = 20      // Trim Galore: Phred cut-off for 3' quality trimming
    trim_min_length       = 36      // Trim Galore: drop pairs where either read is shorter
    trim_galore_fastqc    = true    // Trim Galore: run FastQC on trimmed reads
    trim_galore_args      = ""      // extra Trim Galore options
    fastp_args            = ""      // extra fastp options (only with --trimmer fastp)

    // ── Species gate (Kraken2 + Bracken) ─────────────────────────────────────
    skip_species_check    = false
    target_species        = null    // e.g. "Klebsiella pneumoniae"; null = purity check only
    min_species_fraction  = 0.93    // Bracken fraction_total_reads of the top species
    read_len              = 100     // Bracken read length (needs a matching kmer_distrib)
    bracken_level         = "S"

    species               = null    // organism label when no Bracken result (assembly entry / --skip_species_check)

    // ── Assembly ─────────────────────────────────────────────────────────────
    min_contig            = 500     // SKESA minimum contig length
    max_contigs           = 200     // assembly QC gate

    // ── Annotation ───────────────────────────────────────────────────────────
    prokka_genus          = null    // override the per-sample genus label
    prokka_species        = null    // override the per-sample species label
    prokka_usegenus       = false   // --usegenus (needs a Prokka genus database for that genus)
    prokka_proteins       = null    // trusted protein FASTA of a well-annotated strain
    prokka_centre         = "CDC"
    prokka_evalue         = "1e-6"

    // ── Typing (species-restricted) ─────────────────────────────────────────
    kaptive               = "auto"  // auto | off | comma list of ab_k,ab_o,kpsc_k,kpsc_o

    // ── Pangenome ────────────────────────────────────────────────────────────
    skip_pangenome        = false
    roary_identity        = 95      // minimum BLASTP % identity
    roary_core            = 99      // % of isolates a gene must be in to be core
    roary_core_alignment  = true    // -e: core-gene alignment
    roary_mafft           = false   // use MAFFT instead of PRANK for the alignment

    // ── Resources ────────────────────────────────────────────────────────────
    max_cpus              = Math.min(16, Runtime.runtime.availableProcessors())   // capped at the cores of this machine
    max_memory            = '16.GB'   // lower to the RAM of your machine if needed
    max_time              = '48.h'
}

process {
    resourceLimits = [ cpus: params.max_cpus as int, memory: params.max_memory, time: params.max_time ]
    errorStrategy  = 'finish'

    withLabel: 'process_single' { cpus = 1;  memory = '2.GB';  time = '1.h'  }
    withLabel: 'process_low'    { cpus = 2;  memory = '8.GB';  time = '2.h'  }
    withLabel: 'process_medium' { cpus = 6;  memory = '8.GB';  time = '6.h'  }
    withLabel: 'process_high'   { cpus = 8;  memory = '16.GB'; time = '12.h' }

    withName: 'KRAKEN2' { memory = '12.GB' }   // standard 8 GB database + overhead
    withName: 'BRACKEN' { maxForks = 2 }
    withName: 'KAPTIVE' { cpus = 2; memory = '4.GB' }
}

// ── Software: bioconda versions (used by the conda and docker profiles) ─────

profiles {
    standard {
        process.executor = 'local'
    }
    conda {
        conda.enabled  = true
        conda.useMamba = true
        process {
        withName: 'REMOVE_PHIX'         { conda = 'bioconda::bwa=0.7.18 bioconda::samtools=1.20' }
        withName: 'TRIM_GALORE'         { conda = 'bioconda::trim-galore=0.6.10' }
        withName: 'FASTP'               { conda = 'bioconda::fastp=0.23.4' }
        withName: 'KRAKEN2'             { conda = 'bioconda::kraken2=2.1.3' }
        withName: 'BRACKEN'             { conda = 'bioconda::bracken=2.9' }
        withName: 'SKESA'               { conda = 'bioconda::skesa=2.5.1' }
        withName: 'FASTANI'             { conda = 'bioconda::fastani=1.34' }
        withName: 'PROKKA'              { conda = 'bioconda::prokka=1.14.6' }
        withName: 'ROARY'               { conda = 'bioconda::roary=3.13.0' }
        withName: 'SNIPPY|SNIPPY_CORE'  { conda = 'bioconda::snippy=4.6.0' }
        withName: 'RGI_LOAD|RGI_MAIN'   { conda = 'bioconda::rgi=6.0.3' }
        withName: 'QUAST'               { conda = 'bioconda::quast=5.2.0' }
        withName: 'KAPTIVE'             { conda = 'bioconda::kaptive=3.1.0' }
        withName: 'MULTIQC'             { conda = 'bioconda::multiqc=1.25' }
        }
    }
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        wave.enabled      = true
        wave.strategy     = ['conda']
        process {
        withName: 'REMOVE_PHIX'         { conda = 'bioconda::bwa=0.7.18 bioconda::samtools=1.20' }
        withName: 'TRIM_GALORE'         { conda = 'bioconda::trim-galore=0.6.10' }
        withName: 'FASTP'               { conda = 'bioconda::fastp=0.23.4' }
        withName: 'KRAKEN2'             { conda = 'bioconda::kraken2=2.1.3' }
        withName: 'BRACKEN'             { conda = 'bioconda::bracken=2.9' }
        withName: 'SKESA'               { conda = 'bioconda::skesa=2.5.1' }
        withName: 'FASTANI'             { conda = 'bioconda::fastani=1.34' }
        withName: 'PROKKA'              { conda = 'bioconda::prokka=1.14.6' }
        withName: 'ROARY'               { conda = 'bioconda::roary=3.13.0' }
        withName: 'SNIPPY|SNIPPY_CORE'  { conda = 'bioconda::snippy=4.6.0' }
        withName: 'RGI_LOAD|RGI_MAIN'   { conda = 'bioconda::rgi=6.0.3' }
        withName: 'QUAST'               { conda = 'bioconda::quast=5.2.0' }
        withName: 'KAPTIVE'             { conda = 'bioconda::kaptive=3.1.0' }
        withName: 'MULTIQC'             { conda = 'bioconda::multiqc=1.25' }
        }
    }
    slurm {
        process.executor       = 'slurm'
        process.queue          = 'normal'
        executor.queueSize     = 50
    }
    test {
        params.reads          = "${projectDir}/test_data/*_R{1,2}.fastq.gz"
        params.kraken_db      = "${projectDir}/test_data"
        params.phix           = "${projectDir}/test_data/phix.fa"
        params.reference      = "${projectDir}/test_data/reference.fa"
        params.card_json      = "${projectDir}/test_data/card.json"
        process.resourceLimits = [cpus: 2, memory: '3.GB', time: '1.h']
    }
}

report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html"   }
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt"     }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.html"      }

manifest {
    name            = 'bacterial-wgs-nf'
    author          = 'Abdulmalek T. Algarni'
    homePage        = 'https://github.com/atalgarni/bacterial-wgs-nf'
    description     = 'Species-agnostic Illumina bacterial isolate WGS: QC, species identification, assembly, annotation, AMR, core-genome SNPs, pangenome and (A. baumannii / K. pneumoniae SC) Kaptive typing'
    version         = '1.0.0'
    nextflowVersion = '>=24.04.0'
    mainScript      = 'main.nf'
}
